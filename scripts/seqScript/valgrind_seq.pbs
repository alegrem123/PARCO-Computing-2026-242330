#!/bin/bash
#PBS -N valgrind_seq
#PBS -q short_cpuQ
#PBS -o valgrind_seq.out
#PBS -e valgrind_seq.err
#PBS -l select=1:ncpus=1:mem=64gb
#PBS -l walltime=06:00:00

module load valgrind-3.15.0
module load gcc91

REPO_DIR="$(dirname $(dirname $PBS_O_WORKDIR))"

SRC="$REPO_DIR/src/sequentialCode"
MTX_DIR="$REPO_DIR/mtx"
OUTDIR="$REPO_DIR/results/seqResults/benchMarkingCache"

mkdir -p "$OUTDIR"

cd "$SRC" || exit 1

gcc -std=c99 seqCode.c -o seqCode
EXEC="$SRC/seqCode"

LOOPS="${L:-1}"

for DIR in "$MTX_DIR"/*; do
    [ -d "$DIR" ] || continue

    base=$(basename "$DIR")
    matrix="$DIR/$base.mtx"

    [ -f "$matrix" ] || continue

    for ((i=1; i<=LOOPS; i++)); do
        OUTCG="${OUTDIR}/cachegrind_${base}_run${i}.out"
        OUTTXT="${OUTDIR}/valgrind_${base}_run${i}.txt"

        valgrind --tool=cachegrind \
                 --cachegrind-out-file="$OUTCG" \
                 "$EXEC" "$matrix" &> /dev/null

        I1=$(grep "I1  misses:"  "$OUTCG" | awk '{print $4}')
        IL1=$(grep "LLi misses:" "$OUTCG" | awk '{print $4}')
        D1=$(grep "D1  misses:"  "$OUTCG" | awk '{print $4}')
        DL1=$(grep "LLd misses:" "$OUTCG" | awk '{print $4}')
        LL=$(grep "LL  misses:" "$OUTCG" | awk '{print $4}')

        {
            echo "Matrix: $base"
            echo "Run: $i"
            echo "I1_misses:  $I1"
            echo "IL1_misses: $IL1"
            echo "D1_misses:  $D1"
            echo "DL1_misses: $DL1"
            echo "LL_misses:  $LL"
        } > "$OUTTXT"
    done
done

echo "COMPLETED."
