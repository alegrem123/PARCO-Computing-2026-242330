#!/bin/bash
#PBS -N seqCode
#PBS -o seqCode.out
#PBS -e seqCode.err
#PBS -q short_cpuQ
#PBS -l select=1:ncpus=1:mem=64gb
#PBS -l walltime=06:00:00

module load gcc91

REPO_DIR="$(dirname $(dirname $PBS_O_WORKDIR))"

SRC="$REPO_DIR/src/sequentialCode"
MTX="$REPO_DIR/mtx"
OUTDIR="$REPO_DIR/results/seqResults/benchMarking"

mkdir -p "$OUTDIR"
OUTFILE="$OUTDIR/results_sequential.csv"

cd "$SRC" || exit 1

gcc -std=c99 seqCode.c -o seqCode

LOOPS="${L:-1}"

echo "matrix,run,time_ms,checksum" > "$OUTFILE"

for DIR in "$MTX"/*; do
    [ -d "$DIR" ] || continue

    base=$(basename "$DIR")
    matrix="$DIR/$base.mtx"

    [ -f "$matrix" ] || continue

    for ((i=1; i<=LOOPS; i++)); do
        OUT=$("./seqCode" "$matrix")
        TIME=$(echo "$OUT" | grep "SpMV time" | awk '{print $3}')
        CHECKSUM=$(echo "$OUT" | grep "Checksum" | awk '{print $2}')
        echo "$base,$i,$TIME,$CHECKSUM" >> "$OUTFILE"
    done
done

echo "DONE."
